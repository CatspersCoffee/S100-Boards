NET "A6"    		LOC =  "P74";   #
NET "A7"    		LOC =  "P82";   #
NET "A8"    		LOC =  "P61";   #
NET "A9"    		LOC =  "P50";   #
NET "A10"    		LOC =  "P42";   #
NET "A11"    		LOC =  "P60";   #
NET "A12"    		LOC =  "P64";   #
NET "A13"    		LOC =  "P77";   #
NET "A14"    		LOC =  "P63";   #
NET "A15"    		LOC =  "P86";   #

NET "A20"    		LOC =  "P32";   #
NET "A21"    		LOC =  "P49";   #
NET "A22"    		LOC =  "P35";   #
NET "A23"    		LOC =  "P37";   #

