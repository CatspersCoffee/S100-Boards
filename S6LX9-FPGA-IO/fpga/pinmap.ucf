NET "pWRb"    		LOC =  "P95";   #active low - when processor Writes to I/O or MEM (s100 Pin 77)
NET "sMEMRb"    	LOC =  "P101";   #active high - MEM RD (s100 Pin 47)
NET "MWRTb"    	LOC =  "P99";   #active high - MEM WR (s100 Pin 68)

