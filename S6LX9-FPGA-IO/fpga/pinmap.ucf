#PIN MAP OF U30 S6LX9 i/o board Verison 1


#------ OUTPUTS ------------------------------------------------------

NET "DBUSOUT"    		LOC =  "P5"; 	#Data bus out enable to U20 - 7HC541 
NET "DBUSIN"    		LOC =  "P2"; 	#Data bus in enable to U18 - 7HC541
NET "U8DIR"    		LOC =  "P74";   #U8 DIR pin, DATA buffer 74HC245

NET "DiodeP6"    		LOC =  "P6"; 	# LED 
NET "DiodeP7"    		LOC =  "P7" ; 	# LED 
NET "DiodeP8"    		LOC =  "P8"; 	# LED 
#NET "DiodeP1"    LOC =  "P1"| IOSTANDARD = LVTTL | PULLDOWN ; 	# LED 
NET "DiodeP1"    		LOC =  "P1"; 	# LED 
NET "DiodeP119"    	LOC =  "P119"; 	# LED 
NET "DiodeP118"    	LOC =  "P118"; 	# LED 

NET "P144"    		LOC =  "P144"; 	# pin 144 
NET "P117"    		LOC =  "P117"; 	# pin 117 
