NET "P88"    		LOC =  "P88"; 		# pin 88 
NET "P66"    		LOC =  "P66"; 		# pin 66 


#------ INPUTS -------------------------------------------------------

NET "CLK1"    LOC =  "P85"; 	# from onboard clock DIP selector

